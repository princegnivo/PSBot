# --- Telegram ---
# Remplace par le token donné par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here
# Remplace par ton ID Telegram (via @userinfobot), plusieurs IDs possibles séparés par des virgules
ALLOWED_CHAT_IDS=111111111

# --- Session Pocket Option ---
# SSID récupéré manuellement (DevTools > Network > WS > message d'auth).
# Ce bot n'automatise AUCUNE connexion ni contournement de CAPTCHA.
PO_SSID=colle_ton_ssid_ici
# UID numérique visible dans le même message d'auth WebSocket que le SSID
PO_UID=0
PO_IS_DEMO=true
# EU, US, US_SOUTH, ASIA, DEMO, DEMO2, FRANCE, RUSSIA, INDIA, HONGKONG
PO_REGION=EU

# --- Paramètres de scan ---
# PAIRS = tickers bruts (SANS drapeaux/emojis) envoyés à l'API Pocket Option.
# Les drapeaux sont ajoutés automatiquement dans les messages de signal
# (voir app/pairs_display.py) — rien à changer ici pour ça.
#
# Vérifie/adapte les tickers exotiques ou inversés (UAH/USD, KES/USD,
# AED/CNY...) via les DevTools : certains pourraient ne pas exister tels
# quels, voire pas du tout, sur Pocket Option.
PAIRS=EURUSD_otc,USDJPY_otc,GBPUSD_otc,USDCAD_otc,USDCHF_otc,AUDUSD_otc,NZDUSD_otc,EURGBP_otc,EURJPY_otc,EURCAD_otc,EURCHF_otc,EURNZD_otc,EURHUF_otc,EURTRY_otc,EURRUB_otc,GBPJPY_otc,GBPCAD_otc,GBPCHF_otc,GBPAUD_otc,AUDCAD_otc,AUDCHF_otc,AUDJPY_otc,AUDNZD_otc,CADCHF_otc,CADJPY_otc,CHFJPY_otc,CHFNOK_otc,NZDJPY_otc,USDCNH_otc,USDINR_otc,USDBRL_otc,USDRUB_otc,USDTRY_otc,USDMXN_otc,USDEGP_otc,USDPHP_otc,USDPKR_otc,USDIDR_otc,USDMYR_otc,USDTHB_otc,USDZAR_otc,USDARS_otc,USDCOP_otc,USDCLP_otc,USDBDT_otc,USDVND_otc,USDDZD_otc,USDSGD_otc,UAHUSD_otc,NGNUSD_otc,MADUSD_otc,ZARUSD_otc,YERUSD_otc,LBPUSD_otc,KESUSD_otc,TNDUSD_otc,AEDCNY_otc,OMRCNY_otc,SARCNY_otc,QARCNY_otc,JODCNY_otc,BHDCNY_otc

MIN_PAYOUT=87

# Les 4 stratégies sont actives : S10, M1, M2 et M5.
# TIMEFRAMES est exprimé en SECONDES : 10=S10, 60=M1, 120=M2, 300=M5.
# Dans Telegram, tu peux quand même désactiver/réactiver chaque timeframe
# individuellement avec les boutons ✅/⬜️ du menu (/start).
TIMEFRAMES=10,60,120,300
SCAN_INTERVAL_SECONDS=10

# --- Logs ---
LOG_LEVEL=INFO
LOG_DIR=./logs
